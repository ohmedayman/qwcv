{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid",
        "cvs": {
          "$cvId": {
            ".validate": "newData.hasChildren(['name', 'data']) || newData.val() === null"
          }
        },
        "trash": {
          "$cvId": {
            ".validate": "newData.hasChildren(['data']) || newData.val() === null"
          }
        },
        "notifications": {
          "$notifId": {
            ".validate": "newData.hasChildren(['type', 'text', 'timestamp']) || newData.child('read').isBoolean()"
          }
        },
        "profile": {
          ".validate": "newData.isObject()"
        },
        "portfolio": {
          ".validate": "newData.isObject()"
        },
        "tracker": {
          "$jobId": {
            ".validate": "newData.isObject()"
          }
        }
      }
    },
    "staff": {
      ".read": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    },
    "subscriptions": {
      ".read": "auth !== null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin' || data.child($subId).child('userId').val() === auth.uid)",
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      "$subId": {
        ".validate": "newData.hasChildren(['userId', 'plan', 'paymentMethod'])"
      }
    },
    "jobs": {
      ".read": true,
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      "$jobId": {
        ".validate": "newData.hasChildren(['title', 'category'])"
      }
    },
    "domains": {
      ".read": true,
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    },
    "settings": {
      ".read": true,
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    },
    "siteSettings": {
      ".read": true,
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    },
    "portfolioLinks": {
      ".read": "auth !== null",
      ".write": "auth !== null",
      "$code": {
        ".validate": "newData.isString() && newData.val().length > 0"
      }
    },
    "messages": {
      ".read": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      ".write": "auth !== null"
    },
    "referrals": {
      ".read": "auth !== null && auth.uid === $userId",
      ".write": "auth !== null",
      "$userId": {
        ".read": "auth !== null && auth.uid === $userId"
      }
    },
    "affiliateCampaigns": {
      ".read": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    },
    "affiliateCommissions": {
      ".read": "auth !== null",
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    },
    "analytics": {
      ".read": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      ".write": "auth !== null"
    },
    "approvedDomains": {
      ".read": true,
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    },
    "newsletter": {
      ".read": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      ".write": true,
      "$email": {
        ".validate": "newData.hasChildren(['email'])"
      }
    },
    "support": {
      ".read": "auth !== null",
      ".write": true,
      "$ticketId": {
        ".read": "auth !== null && (root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin' || data.child('userId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['userName', 'userEmail', 'message', 'userId']) || newData.child('status').val() === 'closed' || newData.child('replies').exists()"
      }
    },
    "auditLog": {
      ".read": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    },
    "affiliateRequests": {
      ".read": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      ".write": "auth !== null"
    },
    "pointsExchange": {
      ".read": "auth !== null && auth.uid === $uid",
      ".write": "auth !== null && auth.uid === $uid",
      "$uid": {
        ".validate": "newData.isObject()"
      }
    },
    "adminNotifications": {
      ".read": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'",
      ".write": "auth !== null && root.child('users').child(auth.uid).child('profile').child('role').val() === 'admin'"
    }
  }
}
